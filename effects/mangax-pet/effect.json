{
  "$schema": "../../schema/effect.schema.json",
  "schema": 1,
  "id": "redevrx.mangax-pet",
  "version": "2.3.0",
  "name": { "en": "MangaX Pet", "th": "สัตว์เลี้ยง MangaX" },
  "description": {
    "en": "A cute mascot with 52 poses that walks, sleeps, reacts to translation, and can stand in for the menu button.",
    "th": "มาสคอตน่ารัก 52 ท่าทาง เดินได้ นอนได้ ตอบสนองการแปล ใช้แทนปุ่มเมนูได้"
  },
  "author": { "name": "redevrx", "url": "https://github.com/redevrx" },
  "type": "toggle",
  "category": "appearance",
  "icon": "pets",
  "entry": "main.js",
  "matches": ["*://*/*"],
  "engines": ["any"],
  "permissions": ["toast", "menu", "engine"],
  "keywords": ["mascot", "pet", "มาสคอต", "สัตว์เลี้ยง", "น่ารัก", "ท่าทาง"],
  "options": [
    {
      "key": "size",
      "type": "slider",
      "label": { "en": "Size", "th": "ขนาด" },
      "min": 50, "max": 240, "step": 5, "default": 80, "unit": "px"
    },
    {
      "key": "position",
      "type": "select",
      "label": { "en": "Default position", "th": "ตำแหน่งเริ่มต้น" },
      "choices": [
        { "value": "top", "label": { "en": "Top", "th": "ด้านบน" } },
        { "value": "bottom", "label": { "en": "Bottom", "th": "ด้านล่าง" } }
      ],
      "default": "top"
    },
    {
      "key": "energy",
      "type": "select",
      "label": { "en": "Energy", "th": "พลังงาน" },
      "choices": [
        { "value": "lazy", "label": { "en": "Lazy", "th": "ขี้เกียจ" } },
        { "value": "normal", "label": { "en": "Normal", "th": "ปกติ" } },
        { "value": "hyper", "label": { "en": "Hyper", "th": "ซนมาก" } }
      ],
      "default": "normal"
    },
    {
      "key": "interactive",
      "type": "boolean",
      "label": { "en": "React to reading", "th": "ตอบสนองการอ่าน" },
      "default": true
    },
    {
      "key": "replaceMenu",
      "type": "boolean",
      "label": { "en": "Use instead of the menu button (long-press to open)", "th": "ใช้แทนปุ่มเมนู (กดค้างเพื่อเปิด)" },
      "default": false
    },
    {
      "key": "chattiness",
      "type": "select",
      "label": { "en": "Chattiness", "th": "ความช่างพูด" },
      "choices": [
        { "value": "quiet", "label": { "en": "Quiet", "th": "เงียบ" } },
        { "value": "normal", "label": { "en": "Normal", "th": "ปกติ" } },
        { "value": "chatty", "label": { "en": "Chatty", "th": "ช่างพูด" } }
      ],
      "default": "normal"
    }
  ]
}